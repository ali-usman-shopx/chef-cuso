

{% liquid
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% if section.settings.multiple_collections_enabled == false %}
    {% capture list_items %}
      {% if section.settings.collection != blank and shop.products_count != 0 %}
        {% paginate section.settings.collection.products by max_items %}
          {% for product in section.settings.collection.products limit: max_items %}
          <div
            class="resource-list__item"
          >
              {% content_for 'block',
                type: '_product-card',
                id: 'static-product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </div>

            {% unless forloop.last %}
              <!--@list/split-->
            {% endunless %}
          {% endfor %}
        {% endpaginate %}
      {% else %}
        {% for i in (1..max_items) %}
          <div
            class="resource-list__item"
          >
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endif %}
    {% endcapture %}

    {% liquid
      # Create an array from the list items to be used for different layout types
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      slide_count: max_items,
      content_type: 'products',
      test_id: 'resource-list-grid'
    %}
  {% else %}
    {% if section.settings.render_tabs %}
      <div class="tabs-wrapper">
        <div class="collection-tabs">
          <div class="tab-labels">
            <span id="tab-label-1" data-collection="1" class="tab-label active">Best Sellers</span>
            <span id="tab-label-2" data-collection="2" class="tab-label">Seasonings & Rubs</span>
            <span id="tab-label-3" data-collection="3" class="tab-label">Kitchen Knives</span>
            <span id="tab-label-4" data-collection="4" class="tab-label">Accessories & Apparel</span>
          </div>
          <div class="tab-underlines">
            <span class="tab-underline"></span>
          </div>
        </div>
      </div>
    {% endif %}

    {% for selected_collection in section.settings.collections %}
      <div
        class="collection-panel {% if forloop.first %}active{% endif %}"
        data-collection-id="{{ forloop.index }}"
      >
        {% capture list_items %}
          {% if selected_collection != blank and shop.products_count != 0 %}
            {% paginate selected_collection.products by max_items %}
              {% for product in selected_collection.products limit: max_items %}
              <div
                class="resource-list__item"
              >
                  {% content_for 'block',
                    type: '_product-card',
                    id: 'static-product-card',
                    closest.product: product,
                    product_view_context: 'collection',
                    is_special: forloop.first
                  %}
                </div>

                {% unless forloop.last %}
                  <!--@list/split-->
                {% endunless %}
              {% endfor %}
            {% endpaginate %}
          {% else %}
            {% for i in (1..max_items) %}
              <div
                class="resource-list__item"
              >
                  {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
              </div>

              {% unless forloop.last %}
                <!--@list/split-->
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endcapture %}

        {% liquid
          # Create an array from the list items to be used for different layout types
          assign list_items_array = list_items | strip | split: '<!--@list/split-->'
        %}

        {% render 'resource-list',
          list_items: list_items,
          list_items_array: list_items_array,
          settings: section.settings,
          slide_count: max_items,
          content_type: 'products',
          test_id: 'resource-list-grid'
        %}
      </div>
    {% endfor %}
  {% endif %}
  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% style %}
  {% if section.settings.multiple_collections_enabled %}
    {% if section.settings.render_tabs %}
      .tabs-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        overflow-x: auto;
      }

      .collection-tabs {
        display: flex;
        width: fit-content;
        padding-left: 33px;
        padding-right: 33px;
        padding-bottom: 12px;
        justify-content: center;
        position: relative;
        border-bottom: 2px solid #F1F1F1;
        flex-wrap: nowrap;
      }

      .tab-underlines {
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
      }

      .tab-underline {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 2px;
        background-color: #B92509;
        border-radius: 5px;
        transition: left 0.3s ease, width 0.3s ease;
      }

      .tab-labels {
        display: flex;
        flex-direction: row;
        gap: 30px;
        flex-wrap: nowrap;
      }

      .tab-label {
        font-size: 17px;
        line-height: 100%;
        font-weight: 400;
        color: #646464;
        text-wrap: nowrap;
      }

      .tab-label:hover {
        cursor: pointer;
        color: #4e4e4e;
      }

      .tab-label.active {
        color: #212121;
        font-weight: 400;
      }
    {% endif %}

    .collection-panel {
      display: none;
    }

    .collection-panel.active {
      display: block;
    }

    .collection-panel.active > div > div > slideshow-component
    > slideshow-container > slideshow-slides {
      display: flex;
      flex-direction: row;
      gap: {{ section.settings.carousel_gap_override }}
    }

    slideshow-arrows {
      display: none;
    }

    @media screen and (max-width: 768px) {
      {% if section.settings.render_tabs %}
        .tabs-wrapper {
          justify-content: flex-start;
        }

        .collection-tabs {
          padding-left: 0px;
          padding-right: 0px;
        }

        .tab-labels {
          width: max-content;
        }
      {% endif %}

      .resource-list__slide {
        width: 100% !important;
      }

      .product-card .text-block {
        width: 100%;
      }

      .product-card .text-block > p {
        text-align: center;
        width: 100%;
      }

      .product-card .rating-wrapper {
        justify-content: center;
      }

      .product-card .price-container {
        width: fit-content;
        align-self: center;
      }

      /* Indicators */
      slideshow-arrows {
        display: flex;
      }

      slideshow-arrows .slideshow-control {
        width: 30px;
        height: 30px;
        min-width: 30px;
        min-height: 30px;

        background-color: #212121 !important;
        color: white !important;

        opacity: 1;
      }

      .resource-list__carousel .slideshow-control[disabled] {
        display: flex;

        background-color: white !important;
        color: black !important;
        border: 1px solid black;

        opacity: 1;
      }

      slideshow-arrows .slideshow-control:first-child {
        margin-left: -30px;
      }

      slideshow-arrows .slideshow-control:last-child {
        margin-right: -30px;
      }
    }
  {% endif %}
{% endstyle %}

{% if section.settings.multiple_collections_enabled %}
  {% comment %} Initializes Active Tab and Collection {% endcomment %}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.tab-labels span');
      const underlines = document.querySelectorAll('.tab-underlines span');
      const collections = document.querySelectorAll('.collection-panel');

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          const collectionId = tab.dataset.collection;

          // Active tab
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          const activeUnderline = document.querySelector(
            `#tab-underline-${collectionId}`
          );

          if (activeUnderline) {
            activeUnderline.classList.add('active');
          }

          // Active collection
          collections.forEach((collection) => {
            collection.classList.remove('active');
          });

          const activeCollection = document.querySelector(
            `.collection-panel[data-collection-id="${collectionId}"]`
          );

          if (activeCollection) {
            activeCollection.classList.add('active');
          }
        });
      });

      // Set first tab active initially
      if (tabs[0]) {
        tabs[0].classList.add('active');
      }

      // Set first collection active initially
      if (collections[0]) {
        collections[0].classList.add('active');
      }
    });
  </script>

  {% comment %} Initializes Tab Underline {% endcomment %}
  {% if section.settings.render_tabs %}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.tab-label');
        const underline = document.querySelector('.tab-underline');
        const tabsContainer = document.querySelector('.collection-tabs');

        function moveUnderline(tab) {
          const tabRect = tab.getBoundingClientRect();
          const containerRect = tabsContainer.getBoundingClientRect();

          const underlineWidth = 60;

          underline.style.width = `${underlineWidth}px`;
          underline.style.left = `${
            tabRect.left - containerRect.left + (tabRect.width - underlineWidth) / 2
          }px`;
        }

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((item) => item.classList.remove('active'));
            tab.classList.add('active');

            moveUnderline(tab);
          });
        });

        const activeTab = document.querySelector('.tab-label.active');

        if (activeTab) {
          moveUnderline(activeTab);
        }

        window.addEventListener('resize', () => {
          const activeTab = document.querySelector('.tab-label.active');

          if (activeTab) {
            moveUnderline(activeTab);
          }
        });
      });
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
