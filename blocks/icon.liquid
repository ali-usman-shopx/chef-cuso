

{% assign block_settings = block.settings %}
{% assign icon_block_class = 'icon-block__media icon-block-' | append: block.id %}

{% if block_settings.icon_color != blank %}
  {% style %}
    .icon-block-{{ block.id }} {
      --hover-fill-color: {{ block.settings.tastes_hover_color }};

      color: {{ block_settings.icon_color }};
    }
  {% endstyle %}
{% endif %}

{% capture icon %}
  {% if block_settings.is_tastes_element_icon %}
    <svg
      class="{{ icon_block_class }} tastes_tooltip_icon"
      width="{{ block_settings.width }}"
      height="{{ block_settings.width }}"
      viewBox="0 0 44 44"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      style="background-color: {{ block_settings.background_color | default: 'transparent' }};"
      {{ block.shopify_attributes }}
      aria-hidden="true"
    >
      <!-- Circular border -->
      <circle
        cx="22"
        cy="22"
        r="20"
        stroke="currentColor"
        stroke-width="2"
      />

      <!-- Cross Icon -->
      <path
        d="M15 22H29M22 15V29"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  {% else %}
    {% render 'icon-or-image',
      icon: block_settings.icon,
      image_upload: block_settings.image_upload,
      width: block_settings.width,
      class_name: icon_block_class,
      attributes: block.shopify_attributes
    %}
  {% endif %}
{% endcapture %}

{%- if block_settings.link != blank -%}
  <a
    href="{{ block_settings.link }}"
    class="text-inherit"
    {% if block_settings.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{ icon }}
  </a>
{%- else -%}
  {{ icon }}
{%- endif -%}

{% stylesheet %}
  .icon-block {
    display: flex;
    flex-shrink: 0;
  }

  .icon-block__media {
    height: auto;
  }

  .tastes_tooltip_icon {
    transition:
      transform 0.3s ease,
      fill 0.3s ease;
  }
  
  .tastes_tooltip-icon > circle {
    transition: stroke 0.05s linear;
  }

  .tastes-tooltip-icon--hover {
    transform: rotate(-45deg);
    fill: var(--hover-fill-color);
  }

  .tastes-tooltip-icon--hover > circle {
    stroke: var(--hover-fill-color);
    transition: stroke 0.05s linear;
  }
{% endstylesheet %}

