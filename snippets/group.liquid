{%- doc -%}
  Renders block content for all blocks that extend the group block.

  @param {string} children - The DOM content of the group block.
  @param {object} settings - The settings of the group block.
  @param {string} shopify_attributes - String with Shopify attributes for the editor.
  @param {string} [class] - Custom classes for the group block.
  @param {string} [style] - Custom inline styles for the group block.
  @param {string} [background_color] - The background color of the group block.
  @param {string} [block_id] - The ID of the group block.

  @example
  {% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}
{%- enddoc -%}

{% liquid
  assign skip_contrast = false
  if settings.background_media != blank and settings.background_media != 'none'
    assign skip_contrast = true
  endif

  assign footer_class = ""
  if settings.is_footer_element
    case settings.footer_element_type
      when "instagram-main-wrapper"
        assign footer_class = "footer-instagram-main-wrapper"
      when "instagram-heading-wrapper"
        assign footer_class = "footer-instagram-heading-wrapper"
      when "instagram-image-wrapper"
        assign footer_class = "footer-instagram-image-wrapper"
      when "content-wrapper"
        assign footer_class = "footer-content-wrapper"
      when "branding"
        assign footer_class = "footer-branding"
      when "logo-wrapper"
        assign footer_class = "footer-logo-wrapper"
      when "links"
        assign footer_class = "footer-links"
      when "links-top-row"
        assign footer_class = "footer-links-top-row"
      when "links-bottom-row"
        assign footer_class = "footer-links-bottom-row"
      when "utilities"
        assign footer_class = "footer-utilities"
      when "payment-logos"
        assign footer_class = "footer-payment-logos"
    endcase
  endif
%}
{% render 'contrast-override', background_color: background_color, section_id: block_id, skip_contrast: skip_contrast %}

<div
  class="
    group-block
    group-block--height-{{ settings.height }}
    group-block--width-{{ settings.width }}
    border-style
    spacing-style
    size-style
    {{ class }}
    {% if background_color != blank %} color-custom-{{ block_id }}{% endif %}
    css_override--{{ block.id }}
    {% if block.settings.is_tastes_parent_element %}no-padding-assertion{% endif %}
    {{ footer_class }}
  "
  style="
    {% render 'border-override', settings: settings %}
    {% render 'spacing-style', settings: settings %}
    {% render 'size-style', settings: settings %}
    {{ style }}
  "
  {{ shopify_attributes }}
  data-testid="group-block"
>
  {%- if settings.link != blank -%}
    <a
      href="{{ settings.link }}"
      class="group-block__link"
      {% if settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    ></a>
  {%- endif -%}

  <div class="group-block__media-wrapper">
    {% render 'background-media',
      background_media: settings.background_media,
      background_video: settings.video,
      background_video_position: settings.video_position,
      background_image: settings.background_image,
      background_image_position: settings.background_image_position,
      placeholder: settings.placeholder
    %}
    {% if settings.toggle_overlay %}
      {% render 'overlay', settings: settings, layer: '0' %}
    {% endif %}
  </div>

  <div
    class="
      group-block-content
      {% if request.design_mode %}group-block-content--design-mode{% endif %}
      layout-panel-flex
      layout-panel-flex--{{ settings.content_direction | default: 'column' }}
      {% if settings.vertical_on_mobile %} mobile-column{% endif %}
    "
    style="{% render 'layout-panel-style', settings: settings %}"
  >
    {{- children -}}
  </div>
</div>

{% stylesheet %}
  .group-block__link {
    position: absolute;
    inset: 0;
  }

  .group-block__link ~ :is(.group-block-content, .group-block__media-wrapper) {
    pointer-events: none;

    :is(a, button, input, textarea, select) {
      pointer-events: auto;
    }
  }

  /* Needs the .group-block__link ~ to be specific enough to take effect. */
  .group-block__link ~ .group-block-content--design-mode {
    pointer-events: auto;
  }

  .tastes-tooltip--visible {
    display: flex !important;
    position: absolute;
    width: min(196px, calc(100vw - 32px));
    padding: 18px;
    color: #212121;
    background-color: white;
    border-radius: 10px;

    transform: translateY(-100%);
  }

  /* Footer Overrides */

  /* Desktop */
  @media screen and (min-width: 769px) {
    .footer-instagram-main-wrapper {
      padding-top: 69px;
      padding-bottom: 60px;
    }

    .footer-instagram-heading-wrapper {
      padding-bottom: 43px;
    }
    
    .footer-instagram-image-wrapper {
      width: 13%;
      max-width: 186px;
    }

    .footer-content-wrapper {
      padding-left: 8%;
      padding-right: 8%;
    }

    .footer-branding {
      border-right: 1px solid #D6D1CB;
      padding-right: 109px;
    }

    .footer-logo-wrapper {
      width: 112px;
    }

    /* .footer-links {} No Overrides; Left a Comment for Explicity. */

    .footer-links-top-row * {
      justify-content: space-around;
    }

    .footer-links-bottom-row {
      margin-left: 9%;
    }

    .footer-utilities {
      padding-left: 8%;
      padding-right: 8%;
    }

    .footer-utilities * {
      justify-content: space-between;
    }

    .footer-payment-logos {
      height: 24px;
      width: 497px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .footer-instagram-main-wrapper {
      padding-top: 40px;
      padding-bottom: 50px;
    }

    .footer-instagram-heading-wrapper {
      padding-bottom: 30px;
    }
    
    .footer-instagram-image-wrapper {
      width: 28%;
    }

    /* .footer-content-wrapper {} No Overrides; Left a Comment for Explicity. */

    .footer-branding {
      padding-bottom: 30px;
      border-bottom: 1px solid #D6D1CB;
      padding-left: 24px;
      padding-right: 24px;
    }
    
    .footer-logo-wrapper {
      width: 83px;
    }

    .footer-links {
      padding-top: 14px;
      padding-bottom: 35px;
      padding-left: 24px;
      padding-right: 24px;
    }

    .footer-links-top-row {margin-bottom: 30px;}

    /* .footer-links-bottom-row {} No Overrides; Left a Comment for Explicity. */

    /* .footer-utilities {} No Overrides; Left a Comment for Explicity. */

    .footer-payment-logos {
      height: 16px;
    }
  }

  /* Tablets */
  @media screen and (max-width: 1070px) and (min-width: 768px) {
    .footer-content-wrapper > .group-block-content {
      --flex-direction: column !important;
    }

    .footer-branding {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid #D6D1CB;
      padding-bottom: 30px;
    }

    .footer-links {
      width: 100%;
    }

    .footer-links > .group-block-content {
      --horizontal-alignment: space-between !important;
      --vertical-alignment: baseline !important;
    }

    .footer-links-top-row > .group-block-content {
      justify-content: space-evenly !important;
    }

    .footer-utilities > .group-block-content {
      --flex-direction: column !important;
    }
  }

{% endstylesheet %}

{% style %}
  {% if settings.use_custom_mobile_gap %}
    @media screen and (max-width: 768px) {
      .css_override--{{ block.id }} .group-block-content {
        gap: {{ settings.mobile_gap }}px;
      }
    }
  {% endif %}

  {% if settings.override_margin_bottom %}
    .css_override--{{ block.id }} {
      margin-bottom: {{ settings.custom_margin_bottom }}px;
    }
  {% endif %}

  {% if block.settings.is_tastes_parent_element %}
    .css_override--{{ block.id }} {
      position: relative;
    }

    .tastes-tooltip__{{ block.id }} {
      display: none;
    }
  {% endif %}
{% endstyle %}

{% if block.settings.is_tastes_parent_element %}
  <script>
    function createTastesTooltip(group) {
      let tooltip = document.createElement('div');

      tooltip.className = 'tastes-tooltip__{{ block.id }}';
      tooltip.textContent = {{ block.settings.tastes_tooltip_text | json }};

      group.appendChild(tooltip);

      return tooltip;
    }

    function positionTooltip(group, tooltip) {
      const groupRect = group.getBoundingClientRect();

      const viewportPadding = 16;
      const tooltipGap = 12;
      const preferredWidth = 196;
      const minimumTooltipWidth = 100;

      const spaceOnRight = window.innerWidth - groupRect.right - viewportPadding - tooltipGap;

      const spaceOnLeft = groupRect.left - viewportPadding - tooltipGap;

      const tooltipOnRight = {{ block.settings.tooltip_on_right | json }};

      let actualSide = tooltipOnRight ? 'right' : 'left';

      const preferredSpace = tooltipOnRight ? spaceOnRight : spaceOnLeft;

      if (preferredSpace < minimumTooltipWidth) {
        actualSide = tooltipOnRight ? 'left' : 'right';
      }

      const availableWidth = actualSide === 'right' ? spaceOnRight : spaceOnLeft;

      const width = Math.min(
        preferredWidth,
        Math.max(minimumTooltipWidth, availableWidth)
      );

      tooltip.style.width = `${width}px`;

      if (actualSide === 'right') {
        tooltip.style.left = `${group.offsetWidth + tooltipGap}px`;
        tooltip.style.right = 'auto';
      } else {
        tooltip.style.left = `${-(width + tooltipGap)}px`;
        tooltip.style.right = 'auto';
      }
    }

    function initTastesTooltip(group) {
      let tooltip = null;

      group.addEventListener('mouseenter', () => {
        if (!tooltip) {
          tooltip = createTastesTooltip(group);
        }

        positionTooltip(group, tooltip);

        tooltip.classList.add('tastes-tooltip--visible');
      });

      group.addEventListener('mouseleave', () => {
        if (tooltip) {
          tooltip.classList.remove('tastes-tooltip--visible');
        }
      });

      window.addEventListener('resize', () => {
        if (tooltip?.classList.contains('tastes-tooltip--visible')) {
          positionTooltip(group, tooltip);
        }
      });
    }

    function initTastesIcons(group) {
      let icons = group.querySelectorAll('.tastes-tooltip-icon');

      if (!icons.length) return;

      group.addEventListener('mouseenter', () => {
        icons.forEach((icon) => {
          icon.classList.add('tastes-tooltip-icon--hover');
        });
      });

      group.addEventListener('mouseleave', () => {
        icons.forEach((icon) => {
          icon.classList.remove('tastes-tooltip-icon--hover');
        });
      });
    }

    document.querySelectorAll('.css_override--{{ block.id }}').forEach((group) => {
      initTastesIcons(group);
      initTastesTooltip(group);
    });
  </script>
{% endif %}
